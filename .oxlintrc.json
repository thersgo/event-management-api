{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc"],
	"categories": {
		"correctness": "error"
	},
	"rules": {"no-console": "error"},
	"overrides": [
		{
			"files": ["src/config/env.ts", "src/scripts/**", "src/server.ts"],
			"rules": {"no-console": "off"}
		}
	],
	"env": {
		"builtin": true
	}
}
