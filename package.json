{
	"name": "event-management-api",
	"version": "0.1.0",
	"description": "Event management api school task.",
	"type": "module",
	"homepage": "https://github.com/thersgo/event-management-api#readme",
	"scripts": {
		"server": "tsx --env-file=.env src/server.ts",
		"start": "node dist/server.js",
		"lint": "oxlint",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"build": "tsc",
		"typecheck": "tsc --noEmit"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/thersgo/event-management-api.git"
	},
	"bugs": {
		"url": "https://github.com/thersgo/event-management-api/issues"
	},
	"engines": {
		"node": ">=22"
	},
	"dependencies": {
		"express": "^5.3.0"
	},
	"devDependencies": {
		"@types/express": "^5.0.6",
		"@types/node": "^26.6.6",
		"oxlint": "^1.94.0",
		"prettier": "^3.10.1",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	},
	"allowScripts": {
		"esbuild@0.28.2": true
	}
}
